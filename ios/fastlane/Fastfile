# Fastlane — ardiyesizgiris.com iOS CI/CD
#
# Prerequisites (run once):
#   1. fastlane match init  (set up code signing with a private git repo)
#   2. fastlane match appstore  (generate App Store distribution certs & profiles)
#   3. App Store Connect API Key from:
#      https://appstoreconnect.apple.com/access/integrations/api
#      Store the .p8 key file in ~/private_keys/
#
# Required CI secrets:
#   APPSTORE_CONNECT_KEY_ID      — Key ID from App Store Connect
#   APPSTORE_CONNECT_ISSUER_ID   — Issuer ID from App Store Connect
#   MATCH_PASSWORD               — Encryption password for Match certificates
#   MATCH_GIT_URL                — Private git repo URL for Match storage

default_platform(:ios)

platform :ios do
  before_all do
    ENV["FASTLANE_ITUNES_TRANSPORTER_USE_SHELL_SCRIPT"] = "1"
    ENV["FASTLANE_ITUNES_TRANSPORTER_USE_SHELL_SCRIPT_FOR_UPLOAD"] = "1"
  end

  desc "Build IPA and upload to TestFlight (internal testing)"
  lane :beta do
    # 1. Code signing via Match
    match(
      type: "appstore",
      app_identifier: "com.ardiyesizgiris.web",
      readonly: is_ci,
    )

    # 2. Increment build number
    increment_build_number(
      build_number: latest_testflight_build_number(app_identifier: "com.ardiyesizgiris.web").to_i + 1,
    )

    # 3. Build the IPA (uses Xcode project from Capacitor)
    build_app(
      workspace: "App/App.xcworkspace",
      scheme: "App",
      export_method: "app-store",
      output_directory: "./fastlane/builds",
      include_symbols: true,
      include_bitcode: false,
    )

    # 4. Upload to TestFlight
    upload_to_testflight(
      app_identifier: "com.ardiyesizgiris.web",
      skip_waiting_for_build_processing: false,
      notify_external_testers: false,  # internal only by default
      changelog: "Build #{lane_context[SharedValues::BUILD_NUMBER]} — CI tarafından otomatik yüklendi.",
    )
  end

  desc "Build IPA and upload to TestFlight + notify external testers"
  lane :beta_external do
    beta

    # Optionally distribute to external test group once processing completes
    # Uncomment when external test group is ready:
    # distribute_to_external_testers(
    #   groups: ["external-testers"],
    # )
  end

  desc "Register new devices from Apple Developer"
  lane :register_devices do
    register_devices(
      devices_file: "./fastlane/devices.txt",
    )

    match(
      type: "development",
      app_identifier: "com.ardiyesizgiris.web",
      force_for_new_devices: true,
    )
  end

  desc "Run tests (for future CI expansion)"
  lane :test do
    run_tests(
      workspace: "App/App.xcworkspace",
      scheme: "App",
    )
  end

  desc "Verify CI build pipeline without signing (PR checks)"
  lane :ci_verify do
    # This lane validates that the iOS project can be built from Capacitor
    # output WITHOUT requiring code signing.  Use in PR CI to catch build
    # regressions before merge.
    #
    # Prerequisites: `npx cap add ios` and `npx cap sync ios` already run.
    UI.message("🔍 CI verify: checking Xcode project structure...")

    # Verify the workspace and scheme exist
    workspace_path = "App/App.xcworkspace"
    scheme_name = "App"

    unless File.exist?(workspace_path)
      UI.user_error!("Xcode workspace not found at #{workspace_path}. " \
                     "Did you run `npx cap add ios` and `npx cap sync ios`?")
    end

    # Build for simulator only — no signing needed
    xcodebuild(
      workspace: workspace_path,
      scheme: scheme_name,
      configuration: "Debug",
      sdk: "iphonesimulator",
      destination: "generic/platform=iOS Simulator",
      build_settings: {
        "CODE_SIGNING_ALLOWED" => "NO",
        "CODE_SIGNING_REQUIRED" => "NO",
        "CODE_SIGNING_IDENTITY" => "",
      },
    )

    UI.success("✅ CI verify passed — iOS project builds without signing.")
  end

  desc "First-time setup: guided onboarding for iOS CI/CD"
  lane :setup do
    UI.header("🚀 ardiyesizgiris.com — iOS CI/CD Setup")

    # Step 1: Check prerequisites
    UI.message("Step 1/5: Checking prerequisites...")
    unless system("which fastlane > /dev/null 2>&1")
      UI.user_error!("fastlane not found. Run: gem install fastlane")
    end
    unless system("which pod > /dev/null 2>&1")
      UI.important("CocoaPods not found. Installing...")
      system("gem install cocoapods")
    end
    UI.success("Prerequisites OK")

    # Step 2: Install CocoaPods dependencies
    UI.message("Step 2/5: Installing CocoaPods dependencies...")
    Dir.chdir("App") do
      system("pod install --repo-update") if File.exist?("Podfile")
    end
    UI.success("CocoaPods ready")

    # Step 3: Match setup
    UI.message("Step 3/5: Setting up Match for code signing...")
    if ENV["MATCH_GIT_URL"].to_s.empty?
      UI.important(<<~MSG)
        ⚠️  MATCH_GIT_URL not set.

        Before running match, create a PRIVATE git repo for certificates:
          https://github.com/new

        Then set the environment variable and run:
          export MATCH_GIT_URL="git@github.com:ardiyesizgiris/ardiyesizgiris-certificates.git"
          export MATCH_PASSWORD="<secure-password>"
          fastlane match appstore
          fastlane match development

        For now, skipping Match setup.
      MSG
    else
      match(type: "appstore", app_identifier: "com.ardiyesizgiris.web", readonly: false)
      match(type: "development", app_identifier: "com.ardiyesizgiris.web", readonly: false)
      UI.success("Match configured")
    end

    # Step 4: App Store Connect API key check
    UI.message("Step 4/5: Checking App Store Connect API key...")
    key_path = File.join(Dir.home, "private_keys", "AuthKey_#{ENV['APPSTORE_CONNECT_KEY_ID']}.p8")
    if File.exist?(key_path)
      UI.success("API key found at #{key_path}")
    else
      UI.important(<<~MSG)
        ⚠️  App Store Connect API key not found at #{key_path}.

        Create one at:
          https://appstoreconnect.apple.com/access/integrations/api

        Then place the .p8 file at the path above and set:
          export APPSTORE_CONNECT_KEY_ID="<key-id>"
          export APPSTORE_CONNECT_ISSUER_ID="<issuer-id>"
      MSG
    end

    # Step 5: Summary
    UI.header("📋 Setup Summary")
    UI.message(<<~SUMMARY)
      Completed checks:
        ✅ fastlane installed
        ✅ CocoaPods ready
        #{ENV['MATCH_GIT_URL'] ? '✅' : '⚠️'}  Match code signing
        #{File.exist?(key_path) ? '✅' : '⚠️'}  App Store Connect API key

      Next steps when credentials are ready:
        1. fastlane match appstore   (generate distribution certs)
        2. fastlane beta             (build & upload to TestFlight)
        3. Update Appfile with team_id from:
           https://appstoreconnect.apple.com/ → Membership → Team ID
    SUMMARY
  end
end
