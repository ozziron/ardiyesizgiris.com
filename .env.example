# Premium/Billing DEACTIVATED — reactivation icin plans/son-konu-mam-zda-credit-ve-federated-snowglobe.md
NEXT_PUBLIC_BILLING_ENABLED=false

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ardiyesizgiris"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Email (Resend) — optional. Until you have a real account & verified
# domain, leave RESEND_API_KEY empty (or as the "re_xxxxx" placeholder)
# and the API will return a friendly "yakinda aktif olacak" message
# instead of crashing.
#
# Activation steps when ready:
#   1. Create a Resend account: https://resend.com
#   2. Verify your sending domain (e.g. ardiyesizgiris.com)
#   3. Generate an API key and paste it below as RESEND_API_KEY
#   4. Set EMAIL_FROM to the verified address
#   5. In production, set the same variables in Vercel Production env
#   6. Redeploy/restart the server — no code change needed.
RESEND_API_KEY="re_xxxxx"
EMAIL_FROM="Ardiyesiz Giriş <noreply@ardiyesizgiris.com>"

# When "true", the server skips Resend entirely and logs the composed
# email to the console. Useful for local UI testing before the domain
# is verified. Leave empty/false in production.
EMAIL_DRY_RUN="false"

# ---------------------------------------------------------------------------
# Stripe billing (Premium + Credit Packs)
# ---------------------------------------------------------------------------
# Activation steps when ready:
#   1. Create Stripe account: https://dashboard.stripe.com/register
#   2. Create a recurring Price for Premium subscription (Stripe Billing)
#   3. Create a one-time Price for credit packs
#   4. Get API keys from https://dashboard.stripe.com/apikeys
#   5. Set up webhook endpoint: /api/billing/webhook
#      - Events to listen for: checkout.session.completed
#      - Get the signing secret from the webhook details page
#   6. In production, use live keys and set STRIPE_WEBHOOK_SECRET
#   7. Redeploy/restart the server — no code change needed.
#
# Test mode keys start with sk_test_ / whsec_
# Live mode keys start with sk_live_ / whsec_
# NEVER commit live secret keys to version control.
#
# STRIPE_SECRET_KEY="sk_test_xxxxx"
# STRIPE_PREMIUM_PRICE_ID="price_xxxxx"
# STRIPE_CREDIT_PRICE_ID="price_xxxxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxxxx"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base URL for API calls from static export / Capacitor native app.
# In production (Vercel), set this to the live domain so the Capacitor
# webview can reach the server API routes.
# When empty/omitted, calls use relative paths (works in dev mode only).
# NEXT_PUBLIC_API_BASE_URL="https://www.ardiyesizgiris.com"

# Optional external container tracking provider. Endpoint must accept
# `containerId` and optional `carrierCode` query params and return JSON.
CONTAINER_TRACKING_API_URL=""
CONTAINER_TRACKING_API_KEY=""
CONTAINER_TRACKING_SOURCE="external-provider"

# Node Environment
NODE_ENV="development"

# ---------------------------------------------------------------------------
# Deep Link / Native App (Android App Links + iOS Universal Links)
# ---------------------------------------------------------------------------
# These drive the /.well-known/assetlinks.json and
# /.well-known/apple-app-site-association endpoints so that email links
# (verification, calculation results) open directly in the native app when
# installed.  Without these env vars the endpoints return valid-but-empty
# payloads — HTTPS links fall back to the browser as usual.
#
# Activation steps when the native Capacitor app is ready:
#   1. Android: set DEEP_LINK_ANDROID_PACKAGE_NAME and
#      DEEP_LINK_ANDROID_SHA256_FINGERPRINTS (get fingerprints from
#      the release keystore via keytool -list -v -keystore release.keystore |
#      grep SHA256).
#   2. iOS: set DEEP_LINK_IOS_TEAM_ID (your Apple Developer Team ID) and
#      verify DEEP_LINK_IOS_BUNDLE_ID matches the Xcode bundle identifier.
#   3. Deploy the env changes to Vercel Production — the .well-known/
#      endpoints pick them up on the next request with no code redeploy.
#   4. Verify:
#      - Android: https://digitalassetlinks.googleapis.com/v1/statements:list?
#        source.web.site=https://ardiyesizgiris.com&relation=delegate_permission/common.handle_all_urls
#      - iOS:  https://search.developer.apple.com/appsearch-validation-tool/
#
# Android App Links
DEEP_LINK_ANDROID_PACKAGE_NAME=com.ardiyesizgiris.app
# Comma-separated SHA-256 fingerprints (debug + release), uppercase hex.
# Example: "A1B2C3D4E5F6...,F6E5D4C3B2A1..."
DEEP_LINK_ANDROID_SHA256_FINGERPRINTS=
# iOS Universal Links
DEEP_LINK_IOS_TEAM_ID=
DEEP_LINK_IOS_BUNDLE_ID=com.ardiyesizgiris.app

# ---------------------------------------------------------------------------
# Sentry — Hata izleme ve crash reporting
# ---------------------------------------------------------------------------
# Aktivasyon adımları:
#   1. https://sentry.io adresinde bir proje oluşturun (Next.js)
#   2. Proje Settings → Client Keys (DSN) sayfasından DSN'i kopyalayın
#   3. NEXT_PUBLIC_SENTRY_DSN'i .env.local'e yapıştırın (client-side)
#   4. SENTRY_DSN'i .env.local'e yapıştırın (server-side — aynı değer)
#   5. Source map upload için Sentry Auth Token oluşturun:
#      Sentry → Settings → Auth Tokens → Create New Token
#      Yetkiler: project:releases, project:write, org:read
#   6. SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT değişkenlerini
#      Vercel Production ortamına ekleyin (source map upload yalnızca
#      production build'de çalışır)
#   7. Redeploy — kod değişikliği gerekmez.
#
# Sentry log'ları client-side'da:
#   https://ardiyesizgiris.vercel.app → Sentry project dashboard
#
# NOT: DSN değerleri public olarak client'ta görünür — bu normaldir.
#      Sentry DSN'ler rate-limiting ve origin kontrolü ile korunur.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Optional: Analytics, CDN, etc
# NEXT_PUBLIC_ANALYTICS_ID=""
